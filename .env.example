# DevOS local development configuration
# Copy to .env for local use. Never commit real secrets.

NODE_ENV=development
PORT=3000

# PostgreSQL (see infrastructure/docker/docker-compose.yml)
DATABASE_URL=postgresql://devos:devos@localhost:5432/devos

# Queue
QUEUE_URL=
QUEUE_NAME=

# Object storage
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_REGION=

# Authentication
AUTH_ISSUER_URL=
AUTH_AUDIENCE=

# Logging
LOG_LEVEL=info

# Gemini API key (Sprint 2 — LLM provider adapter, DEVOS-027)
GEMINI_API_KEY=

# DevOS local development configuration
# Copy to .env for local use. Never commit real secrets.

NODE_ENV=development
PORT=3000

# PostgreSQL
DATABASE_URL=

# Queue
QUEUE_URL=
QUEUE_NAME=

# Object storage
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_REGION=

# Authentication
AUTH_ISSUER_URL=
AUTH_AUDIENCE=

# Logging
LOG_LEVEL=info

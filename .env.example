# DevOS local development configuration
# Copy to .env for local use. Never commit real secrets.

NODE_ENV=development
PORT=3000

# PostgreSQL (see infrastructure/docker/docker-compose.yml)
DATABASE_URL=postgresql://devos:devos@localhost:5432/devos

# Queue
QUEUE_URL=
QUEUE_NAME=

# Object storage
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_REGION=

# Authentication (DEVOS-107 — real OIDC via Auth0; local dev falls back to
# the local bearer-token-as-principal-id provider when both are unset).
# AUTH_ISSUER_URL is the Auth0 tenant domain, e.g. https://your-tenant.us.auth0.com/
# AUTH_AUDIENCE is the API identifier registered for the DevOS API in Auth0.
AUTH_ISSUER_URL=
AUTH_AUDIENCE=

# Logging
LOG_LEVEL=info

# Gemini API key (Sprint 2 — LLM provider adapter, DEVOS-027)
GEMINI_API_KEY=

# Vault (real secret-management backend, DEVOS-106 — see
# infrastructure/docker/docker-compose.yml). The token below is the fixed
# local dev-mode root token that compose file sets — not a real secret.
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=devos-dev-root-token

# Metrics export (DEVOS-117 — apps/worker exposes a real Prometheus
# scrape endpoint at GET /metrics when set; unset/0 disables it, since
# tests/e2e spawns multiple worker processes that would otherwise collide
# on a shared fixed port). 9464 is the OpenTelemetry Prometheus exporter's
# own conventional default. See infrastructure/docker/docker-compose.yml's
# `prometheus` service and prometheus.yml's scrape config.
METRICS_PORT=9464
# METRICS_SNAPSHOT_INTERVAL_MS=30000

# Rate limiting (DEVOS-118 — apps/api's mutation rate limiter uses a real
# shared Redis store when set, so multiple apps/api instances enforce one
# combined limit; unset keeps the real in-process limiter, DEVOS-091). See
# infrastructure/docker/docker-compose.yml's `redis` service.
REDIS_URL=redis://localhost:6379

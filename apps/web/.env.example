# DevOS web app local development configuration.
# Vite reads .env files from this directory (apps/web), not the monorepo
# root — copy this to .env here and fill in real values for local use.
# Never commit real values.

VITE_API_BASE_URL=http://localhost:3000
VITE_DEV_PRINCIPAL_ID=seed-user

# DEVOS-107 — real Auth0 tenant (Single Page Application). Leave all three
# unset to keep using the dev-identity fallback (VITE_DEV_PRINCIPAL_ID
# above) with no real login.
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=

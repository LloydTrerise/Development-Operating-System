{
  "name": "@devos/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --config ../../vitest.config.ts",
    "test:watch": "vitest --config ../../vitest.config.ts"
  },
  "dependencies": {
    "@devos/application": "workspace:*",
    "@devos/config": "workspace:*",
    "@devos/contracts": "workspace:*",
    "@devos/database": "workspace:*",
    "@devos/domain": "workspace:*",
    "@devos/identity": "workspace:*",
    "@devos/storage": "workspace:*",
    "ioredis": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "tsx": "^4.20.3",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}

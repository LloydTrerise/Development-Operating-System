{
  "name": "@devos/worker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --config ../../vitest.config.ts",
    "test:watch": "vitest --config ../../vitest.config.ts"
  },
  "dependencies": {
    "@devos/agents": "workspace:*",
    "@devos/application": "workspace:*",
    "@devos/config": "workspace:*",
    "@devos/database": "workspace:*",
    "@devos/domain": "workspace:*",
    "@devos/integrations": "workspace:*",
    "@devos/observability": "workspace:*",
    "@devos/storage": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.3",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
